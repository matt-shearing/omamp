#!/bin/sh
# Installs into ~/.local, for when there's no sudo to hand. bin/install is
# the proper package.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
"$ROOT/bin/build"
install -Dm755 "$ROOT/build/thrum" "$HOME/.local/bin/thrum"
if [ -x "$ROOT/build/thrum-spotify-session" ]; then
    install -Dm755 "$ROOT/build/thrum-spotify-session" "$HOME/.local/bin/thrum-spotify-session"
fi
install -Dm644 "$ROOT/pkgbuild/thrum.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/thrum.svg"
sed "s#^Exec=thrum#Exec=$HOME/.local/bin/thrum#" "$ROOT/pkgbuild/thrum.desktop" \
    > "$HOME/.local/share/applications/thrum.desktop"
update-desktop-database "$HOME/.local/share/applications" 2>/dev/null || true
gtk-update-icon-cache -q "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
echo "Installed thrum for $(id -un)"
