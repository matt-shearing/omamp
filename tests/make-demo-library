#!/bin/bash
# Makes a small made-up library for the README screenshots: twelve albums by
# invented artists, each track a second of a quiet tone, with covers drawn
# by ffmpeg in plain colours (some as cover.jpg beside the tracks, some
# embedded in the files, one album with none). Tracks carry genres, ratings,
# play counts, ReplayGain and, on one album, lyrics.
#
#   tests/make-demo-library <folder>
#
# Nothing here is anyone's real music. CPU only.
set -euo pipefail

out="${1:?usage: make-demo-library <folder>}"
mkdir -p "$out"
cd "$out"

# cover <file> <background> <band> <square>: a 600x600 picture in three colours.
cover() {
    ffmpeg -nostdin -hide_banner -loglevel error -y \
        -f lavfi -i "color=c=$2:s=600x600:d=1" \
        -vf "drawbox=x=0:y=390:w=600:h=210:color=$3:t=fill,drawbox=x=70:y=80:w=220:h=220:color=$4:t=fill" \
        -frames:v 1 -q:v 3 "$1"
}

# tone <file> <frequency> <ffmpeg args...>
# DEMO_SECONDS=<n> makes longer tracks with harmonics, a slow swell and a
# tick of noise every half second, so the analyser and the oscilloscope
# have something to draw in screenshots. Without it, a second of sine.
tone() {
    local file="$1" freq="$2"
    shift 2
    mkdir -p "$(dirname "$file")"
    local source="sine=frequency=$freq:sample_rate=44100:duration=1" volume=0.05
    if [ -n "${DEMO_SECONDS:-}" ]; then
        volume=0.8
        local f=$freq
        source="aevalsrc=exprs='0.32*sin(2*PI*$f*t)*(0.65+0.35*sin(2*PI*0.5*t))+0.2*sin(2*PI*$((f * 2))*t)+0.12*sin(2*PI*$((f * 3))*t+1)+0.08*sin(2*PI*$((f * 5))*t)+0.18*sin(2*PI*55*t)*lt(mod(t,0.5),0.12)+0.12*(random(0)-0.5)*lt(mod(t+0.25,0.5),0.04)':s=44100:d=$DEMO_SECONDS"
    fi
    ffmpeg -nostdin -hide_banner -loglevel error -y \
        -f lavfi -i "$source" \
        -af volume=$volume -map_metadata -1 "$@" "$file"
}

# album <artist> <album> <year> <genre> <art: folder|embedded|none> <bg> <band> <square> <titles...>
# Each title is "Title|rating 0-1|plays".
album() {
    local artist="$1" album="$2" year="$3" genre="$4" art="$5" bg="$6" band="$7" square="$8"
    shift 8
    local dir="$artist/$album"
    mkdir -p "$dir"
    local pic="$dir/.cover-src.jpg"
    if [ "$art" != none ]; then
        cover "$pic" "$bg" "$band" "$square"
    fi
    local n=0
    for entry in "$@"; do
        n=$((n + 1))
        IFS='|' read -r title rating plays <<<"$entry"
        local common=(-metadata title="$title" -metadata artist="$artist" -metadata album_artist="$artist"
            -metadata album="$album" -metadata date="$year" -metadata genre="$genre" -metadata track="$n")
        local gain
        gain=$(printf -- "-%d.%02d dB" $((4 + n % 5)) $((n * 17 % 100)))
        if [ "$art" = embedded ]; then
            # MP3 with the cover as an ID3 picture.
            local tmp="$dir/.tmp.mp3"
            tone "$tmp" $((220 + n * 40)) -c:a libmp3lame -b:a 192k "${common[@]}"
            ffmpeg -nostdin -hide_banner -loglevel error -y -i "$tmp" -i "$pic" -map 0 -map 1 -c copy \
                -id3v2_version 3 -metadata:s:v title="Album cover" -metadata:s:v comment="Cover (front)" \
                -disposition:v attached_pic "$dir/$(printf %02d $n) $title.mp3"
            rm -f "$tmp"
        else
            tone "$dir/$(printf %02d $n) $title.flac" $((220 + n * 40)) "${common[@]}" \
                -metadata FMPS_RATING="$rating" -metadata FMPS_PLAYCOUNT="$plays" \
                -metadata REPLAYGAIN_TRACK_GAIN="$gain" -metadata REPLAYGAIN_TRACK_PEAK=0.912345 \
                -metadata REPLAYGAIN_ALBUM_GAIN="-5.80 dB" -metadata REPLAYGAIN_ALBUM_PEAK=0.988000 \
                ${LYRICS:+-metadata LYRICS="$LYRICS"}
        fi
    done
    if [ "$art" = folder ]; then
        mv "$pic" "$dir/cover.jpg"
    else
        rm -f "$pic"
    fi
}

