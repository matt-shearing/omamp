#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build"
cd "$ROOT/build"

qmake6 "$ROOT/omamp.pro"
make -j"${JOBS:-$(nproc)}"
echo "Built $ROOT/build/omamp"

# omamp-spotify-session reads Spotify's own playlists and artists' top
# tracks (docs/spotify.md). It needs Rust; without cargo, Omamp works
# without it. --locked keeps to the crate versions in Cargo.lock.
SIDECAR="$ROOT/sidecar/omamp-spotify-session"
if command -v cargo >/dev/null 2>&1; then
    cargo build --release --locked -j"${JOBS:-$(nproc)}" --manifest-path "$SIDECAR/Cargo.toml" \
        --target-dir "$ROOT/build/sidecar"
    install -m755 "$ROOT/build/sidecar/release/omamp-spotify-session" "$ROOT/build/omamp-spotify-session"
    echo "Built $ROOT/build/omamp-spotify-session"
else
    echo "cargo isn't installed, so omamp-spotify-session wasn't built (optional)" >&2
fi
