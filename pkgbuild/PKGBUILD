pkgname=thrum
pkgver=0.3.3
pkgrel=1
pkgdesc='A Winamp-style music player that wears the Omarchy theme'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'xdg-desktop-portal' 'ttf-jetbrains-mono-nerd' 'taglib' 'sqlite' 'ffmpeg')
makedepends=('gcc' 'make' 'pkgconf' 'cargo')
# makepkg's default LTO breaks the ring crate's C objects in the Spotify helper.
options=('!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/thrum "$pkgdir/usr/bin/thrum"
  install -Dm755 build/thrum-spotify-session "$pkgdir/usr/bin/thrum-spotify-session"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/thrum.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/thrum.svg"
  install -Dm644 "$startdir/thrum.desktop" "$pkgdir/usr/share/applications/thrum.desktop"
}
