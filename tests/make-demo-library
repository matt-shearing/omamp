#!/bin/bash
# Makes a small made-up library for the README screenshots: eighteen albums
# by invented artists, each track a quiet tone of a believable length, with
# covers drawn by tests/make-demo-cover (or by ffmpeg in plain colours when
# Pillow isn't installed): some as cover.jpg beside the tracks, some embedded
# in the files, one album with none. Tracks carry genres, ratings, play
# counts, ReplayGain and, on one album, lyrics. Neon Coast's tracks carry a
# richer tone, so the analyser and the oscilloscope have something to draw.
#
#   tests/make-demo-library <folder>
#
# Nothing here is anyone's real music. CPU only.
set -euo pipefail

out="${1:?usage: make-demo-library <folder>}"
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
mkdir -p "$out"
cd "$out"

# cover <file> <background> <band> <square> <style> <artist> <album>: a
# 600x600 picture in three colours.
cover() {
    if python3 -c 'import PIL' 2>/dev/null; then
        "$here/make-demo-cover" "$1" "$5" "$2" "$3" "$4" "$6" "$7"
        return
    fi
    ffmpeg -nostdin -hide_banner -loglevel error -y \
        -f lavfi -i "color=c=$2:s=600x600:d=1" \
        -vf "drawbox=x=0:y=390:w=600:h=210:color=$3:t=fill,drawbox=x=70:y=80:w=220:h=220:color=$4:t=fill" \
        -frames:v 1 -q:v 3 "$1"
}

# tone <file> <frequency> <seconds> <rich: 0|1> <ffmpeg args...>
# A rich tone has harmonics, a slow swell and a tick of noise every half
# second, so the analyser and the oscilloscope have something to draw in
# screenshots; the rest are a quiet sine, which keeps the files small.
# DEMO_SECONDS=<n> makes every track that long and rich.
tone() {
    local file="$1" freq="$2" seconds="$3" rich="$4"
    shift 4
    mkdir -p "$(dirname "$file")"
    if [ -n "${DEMO_SECONDS:-}" ]; then
        seconds=$DEMO_SECONDS rich=1
    fi
    local source="sine=frequency=$freq:sample_rate=44100:duration=$seconds" volume=0.02
    if [ "$rich" = 1 ]; then
        volume=0.8
        local f=$freq
        source="aevalsrc=exprs='0.32*sin(2*PI*$f*t)*(0.65+0.35*sin(2*PI*0.5*t))+0.2*sin(2*PI*$((f * 2))*t)+0.12*sin(2*PI*$((f * 3))*t+1)+0.08*sin(2*PI*$((f * 5))*t)+0.18*sin(2*PI*55*t)*lt(mod(t,0.5),0.12)+0.12*(random(0)-0.5)*lt(mod(t+0.25,0.5),0.04)':s=44100:d=$seconds"
    fi
    ffmpeg -nostdin -hide_banner -loglevel error -y \
        -f lavfi -i "$source" \
        -af volume=$volume -map_metadata -1 "$@" "$file"
}

# album <artist> <album> <year> <genre> <art: folder|embedded|none> <style> <bg> <band> <square> <titles...>
# Each title is "Title|rating 0-1|plays|seconds".
album() {
    local artist="$1" album="$2" year="$3" genre="$4" art="$5" style="$6" bg="$7" band="$8" square="$9"
    shift 9
    local dir="$artist/$album"
    mkdir -p "$dir"
    local pic="$dir/.cover-src.jpg"
    if [ "$art" != none ]; then
        cover "$pic" "$bg" "$band" "$square" "$style" "$artist" "$album"
    fi
    local rich=0
    [ "$artist" = "Neon Coast" ] && rich=1
    local n=0
    for entry in "$@"; do
        n=$((n + 1))
        IFS='|' read -r title rating plays seconds <<<"$entry"
        local common=(-metadata title="$title" -metadata artist="$artist" -metadata album_artist="$artist"
            -metadata album="$album" -metadata date="$year" -metadata genre="$genre" -metadata track="$n")
        local gain
        gain=$(printf -- "-%d.%02d dB" $((4 + n % 5)) $((n * 17 % 100)))
        if [ "$art" = embedded ]; then
            # MP3 with the cover as an ID3 picture.
            local tmp="$dir/.tmp.mp3"
            tone "$tmp" $((220 + n * 40)) "$seconds" "$rich" -c:a libmp3lame -b:a 192k "${common[@]}"
            ffmpeg -nostdin -hide_banner -loglevel error -y -i "$tmp" -i "$pic" -map 0 -map 1 -c copy \
                -id3v2_version 3 -metadata:s:v title="Album cover" -metadata:s:v comment="Cover (front)" \
                -disposition:v attached_pic "$dir/$(printf %02d $n) $title.mp3"
            rm -f "$tmp"
        else
            tone "$dir/$(printf %02d $n) $title.flac" $((220 + n * 40)) "$seconds" "$rich" "${common[@]}" \
                -metadata FMPS_RATING="$rating" -metadata FMPS_PLAYCOUNT="$plays" \
                -metadata REPLAYGAIN_TRACK_GAIN="$gain" -metadata REPLAYGAIN_TRACK_PEAK=0.912345 \
                -metadata REPLAYGAIN_ALBUM_GAIN="-5.80 dB" -metadata REPLAYGAIN_ALBUM_PEAK=0.988000 \
                ${LYRICS:+-metadata LYRICS="$LYRICS"}
        fi
    done
    if [ "$art" = folder ]; then
        mv "$pic" "$dir/cover.jpg"
    else
        rm -f "$pic"
    fi
}

