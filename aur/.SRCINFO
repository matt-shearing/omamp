pkgbase = omamp
	pkgdesc = A Winamp-style music player and library manager that wears the Omarchy theme
	pkgver = 0.3.3
	pkgrel = 1
	url = https://github.com/matt-shearing/omamp
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = pkgconf
	makedepends = cargo
	depends = bash
	depends = glibc
	depends = hicolor-icon-theme
	depends = libgcc
	depends = libstdc++
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-multimedia
	depends = taglib
	depends = sqlite
	depends = ffmpeg
	depends = ttf-jetbrains-mono-nerd
	optdepends = qt6-wayland: native Wayland window (otherwise runs under XWayland)
	optdepends = xdg-desktop-portal: file and folder pickers
	optdepends = chromaprint: fpcalc, for duplicate finding and AcoustID identification
	optdepends = libsecret: secret-tool, to keep NAS and Subsonic passwords in the keyring
	optdepends = xdg-utils: xdg-open, for "Show in folder"
	optdepends = hyprland: hyprctl, to match the window rounding of the desktop
	optdepends = quickshell: the Omarchy bar plugin in /usr/share/omamp/omarchy-plugin
	optdepends = spotify-player: Spotify beside your own music (Settings > Spotify)
	options = !lto
	source = omamp-0.3.3.tar.gz::https://github.com/matt-shearing/omamp/archive/refs/tags/v0.3.3.tar.gz
	sha256sums = 7ab1162bcfb1acc04e3eb8755f46244d4053c011b81ec40b0dd55f22463003e5

pkgname = omamp
